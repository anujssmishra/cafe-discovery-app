# Database URL:
# For SQLite (default, zero configuration needed):
DATABASE_URL=sqlite+aiosqlite:///./food_recsys.db

# For PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql+asyncpg://recsys:recsys_password@localhost:5432/food_recsys

APP_NAME=Food RecSys (UPI Taste Intelligence)
DEBUG=true

# Scoring weights (sum to 1.0)
WEIGHT_CUISINE=0.45
WEIGHT_PRICE=0.30
WEIGHT_NOVELTY=0.15
WEIGHT_GEO=0.10
