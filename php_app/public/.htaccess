Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Hidden paths and development/other PHP files are not public endpoints.
RewriteRule (^|/)\. - [F,L]
<FilesMatch "(?i)^(?!index\.php$).*\.php$">
    Require all denied
</FilesMatch>

# Relative substitution supports a domain root or APP_BASE_PATH subdirectory.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
