# Reference only: PHP reads process environment and does NOT load this file.
# Export/set these variables in your shell or a private server environment.
APP_ENV=development
DEMO_MODE=true
# Empty for a document root; /guide for a subdirectory installation.
APP_BASE_PATH=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cafe_discovery
DB_USER=replace-with-local-database-user
DB_PASS=replace-with-local-database-password
# Production must use APP_ENV=production and DEMO_MODE=false. Never seed production.
