# Reference only: PHP does NOT load dotenv files.
# Process environment overrides optional private php_app/config/local.php.
# APP_CONFIG_FILE may select an absolute private PHP config outside public/ or public_html/.
# Export/set variables for local development; use config/local.php on shared hosting.
APP_ENV=development
DEMO_MODE=true
# Empty for a document root; /guide for a subdirectory installation.
APP_BASE_PATH=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cafe_discovery
DB_USER=replace-with-local-database-user
DB_PASS=replace-with-local-database-password
# Production must use APP_ENV=production and DEMO_MODE=false. Never seed production.
